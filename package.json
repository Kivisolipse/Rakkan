{
  "name": "rakkan",
  "version": "0.1.1",
  "description": "Mark which characters in a Markdown note were written by a human, by an AI, or quoted from elsewhere. Every character, signed.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "bin": {
    "rakkan": "skills/rakkan/scripts/rakkan.mjs"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats": "esbuild scripts/stats.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/stats.mjs && node dist/stats.mjs",
    "demo": "npm run build && node scripts/install-demo.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "authorship",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "6.11",
    "@codemirror/state": "6.7",
    "@codemirror/view": "6.43",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "monkey-around": "3.0.0"
  }
}
