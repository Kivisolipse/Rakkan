{
  "name": "rakkan",
  "version": "0.2.0",
  "description": "Mark which characters in a Markdown note were written by a human, by an AI, or quoted from elsewhere. Every character, signed.",
  "type": "module",
  "bin": {
    "rakkan": "skills/rakkan/scripts/rakkan.mjs"
  },
  "files": [
    "skills/rakkan/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "node scripts/fuzz.mjs",
    "stats": "esbuild scripts/stats.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/stats.mjs && node dist/stats.mjs",
    "demo": "npm run build && node scripts/install-demo.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"#!/usr/bin/env node\" --log-level=warning --outfile=dist/rakkan-mcp.mjs"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "authorship",
    "ai",
    "cli",
    "lint",
    "agent-skills"
  ],
  "author": "Kivisolipse",
  "license": "MIT",
  "homepage": "https://github.com/Kivisolipse/Rakkan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kivisolipse/Rakkan.git"
  },
  "bugs": {
    "url": "https://github.com/Kivisolipse/Rakkan/issues"
  },
  "devDependencies": {
    "@codemirror/language": "6.11",
    "@codemirror/state": "6.7",
    "@codemirror/view": "6.43",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "fast-check": "^4.10.2",
    "markdown-it": "^14.3.3",
    "monkey-around": "3.0.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
